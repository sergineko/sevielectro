---
import ResponsiveImage from './ResponsiveImage.astro';
import GalleryProject from './GalleryProject.astro';
import { ArrowUpRight, X, ChevronLeft, ChevronRight, Images, Grid2X2, Loader2 } from 'lucide-react';
import { projects } from '../data/content';
import media from '../data/media.json';
import '../styles/gallery-viewer.css';
import '../styles/gallery-showcase.css';
const orderedProjects=[...projects].sort((a,b)=>(a.showcaseOrder ?? 100)-(b.showcaseOrder ?? 100));
const showcaseLimit=7;
---
<section id="galeria" class="section gallery-section">
  <div class="container">
    <div class="section-heading">
      <div><p class="eyebrow">03 / TRABAJOS REALIZADOS</p><h2>La calidad se ve.<br/><span class="muted">Y también se conecta.</span></h2></div>
      <a class="text-link" href="#contacto">Hablemos de tu proyecto <ArrowUpRight size={18}/></a>
    </div>
    <div class="project-grid showcase-grid">
      {orderedProjects.slice(0,5).map((project,i)=><GalleryProject project={project} lead={i===0} sizes={i===0 ? '(max-width:850px) 90vw, 440px' : '(max-width:850px) 44vw, 370px'}/>)}
    </div>
    <div class="gallery-more-grid">
      {orderedProjects.slice(5,showcaseLimit).map(project=><GalleryProject project={project}/>)}
      <button class="gallery-explore" type="button" data-start-index={projects.length>showcaseLimit ? showcaseLimit : 0} aria-haspopup="dialog" aria-controls="gallery-viewer">
        <Grid2X2 className="gallery-explore-pattern" size={132} strokeWidth={.65} aria-hidden="true"/>
        <span class="gallery-explore-top"><Images size={17} aria-hidden="true"/> TRABAJOS REALIZADOS</span>
        <strong>Ver todos <br/>nuestros trabajos</strong>
        <span class="gallery-explore-action">Seguir viendo <span><ArrowUpRight size={21} aria-hidden="true"/></span></span>
      </button>
    </div>
    <div hidden>{orderedProjects.slice(showcaseLimit).map(project=><GalleryProject project={project}/>)}</div>
  </div>
</section>
<dialog id="gallery-viewer" class="gallery-viewer" aria-labelledby="gallery-viewer-label">
  <div class="viewer-shell">
    <header class="viewer-header">
      <div><span class="viewer-brandline">SEVIELECTRO / TRABAJOS REALIZADOS</span><h2 class="viewer-heading" id="gallery-viewer-label">Galería de proyectos <span class="viewer-total">{projects.length} fotografías</span></h2></div>
      <div class="viewer-tools">
        <button class="viewer-mode" type="button" aria-label="Ver mosaico con todas las fotografías" aria-pressed="false"><Grid2X2 size={17}/><span>Ver mosaico</span></button>
        <button class="viewer-close" type="button" aria-label="Cerrar galería"><X size={22}/></button>
      </div>
    </header>
    <div class="viewer-stage">
      <div class="viewer-ambient" aria-hidden="true"></div>
      <div class="viewer-frame" aria-busy="false">
        <img class="viewer-image" alt="" draggable="false"/>
        <div class="viewer-status" role="status" hidden><Loader2 size={25}/><span class="viewer-status-text">Cargando fotografía…</span><button class="viewer-retry" type="button" hidden>Reintentar</button></div>
      </div>
      <button class="viewer-arrow viewer-prev" type="button" aria-label="Fotografía anterior"><ChevronLeft size={23}/></button>
      <button class="viewer-arrow viewer-next" type="button" aria-label="Fotografía siguiente"><ChevronRight size={23}/></button>
    </div>
    <div class="viewer-details">
      <div><span class="viewer-category"></span><h3 class="viewer-title"></h3></div>
      <div class="viewer-position"><p class="viewer-counter" aria-live="polite"></p><div class="viewer-progress" aria-hidden="true"><span class="viewer-progress-fill"></span></div></div>
    </div>
    <div class="viewer-collection" role="group" aria-label="Seleccionar fotografía">
      {orderedProjects.map((project,i)=><button class="viewer-thumbnail" type="button" aria-label={`Ver fotografía ${i+1}: ${project.title}`} aria-pressed="false">
        <ResponsiveImage src={media[project.file].src} width={media[project.file].width} height={media[project.file].height} loading="lazy" sizes="88px" alt=""/>
        <span class="viewer-thumbnail-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
        <span class="viewer-thumbnail-caption" aria-hidden="true">{project.title}</span>
      </button>)}
    </div>
  </div>
</dialog>
<script>import '../scripts/gallery';</script>
