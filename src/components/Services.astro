---
import { ArrowUpRight, Cable, Camera, BellRing, Zap } from 'lucide-react';
import { services as catalogue } from '../data/services';
const icons={cable:Cable,camera:Camera,alarm:BellRing,electricity:Zap};
const services=catalogue.map(service=>({...service,icon:icons[service.icon]}));
---
<section id="servicios" class="section services"><div class="container"><div class="section-heading"><div><p class="eyebrow">01 / NUESTROS SERVICIOS</p><h2>Todo conectado.<br /><span class="muted">Todo en buenas manos.</span></h2></div><p>Conoce nuestro portafolio de servicios.<br />Estaremos gustosos de ayudarte.</p></div><div class="services-grid">{services.map((s,i)=><a class="service-card" href="#contacto"><div class="card-top"><span class="service-icon"><s.icon size={26} strokeWidth={1.5}/></span><span class="card-number">0{i+1}</span></div><p class="card-tag">{s.detail}</p><h3>{s.title}</h3><p class="service-description">{s.text}</p><span class="card-link">Consultar servicio <ArrowUpRight size={17}/></span></a>)}</div></div></section>
