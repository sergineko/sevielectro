---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LegalNotice from '../components/LegalNotice.astro';
import PrivacyPolicy from '../components/PrivacyPolicy.astro';
import CookiePolicy from '../components/CookiePolicy.astro';
import { ArrowLeft, ArrowUpRight, FileCheck2, ShieldCheck, Settings2 } from 'lucide-react';
import { PRIVACY_VERSION, PRIVACY_DATE_LABEL } from '../lib/privacy';
import '../styles/legal.css';

export function getStaticPaths() {
  return [
    { params:{ legal:'aviso-legal' },props:{
      title:'Aviso legal',description:'Identificación de SeviElectro, condiciones de uso y atención de solicitudes de instalaciones eléctricas en Quito, Ecuador.',
      intro:'Quién está detrás de esta web y las condiciones para utilizar nuestros contenidos y canales de contacto.',
      contents:[['titular','Identificación y contacto'],['servicios-web','Servicios y cotizaciones'],['uso-sitio','Uso del sitio'],['propiedad','Contenidos y autoría'],['enlaces','Enlaces y disponibilidad'],['ley-aplicable','Legislación aplicable']],
    } },
    { params:{ legal:'privacidad' },props:{
      title:'Política de privacidad',description:'Cómo trata SeviElectro tus consultas, datos y adjuntos, sus proveedores y tus derechos de protección de datos personales en Ecuador.',
      intro:'Información clara sobre tus datos, el formulario de contacto y cómo ejercer tus derechos en Ecuador.',
      contents:[['responsable','Responsable'],['datos','Datos que tratamos'],['finalidades','Finalidades y bases'],['proveedores','Destinatarios y exterior'],['conservacion','Conservación'],['derechos','Tus derechos'],['seguridad','Seguridad'],['cambios-privacidad','Actualizaciones']],
    } },
    { params:{ legal:'cookies' },props:{
      title:'Política de cookies',description:'Tecnologías utilizadas por SeviElectro: caché, protección Cloudflare Turnstile y enlaces externos, sin analítica ni publicidad comportamental.',
      intro:'Qué tecnologías utiliza esta web para funcionar con rapidez y proteger el formulario de contacto.',
      contents:[['tecnologias','Qué son estas tecnologías'],['uso-actual','Uso actual del sitio'],['turnstile','Protección del formulario'],['preferencias','Control del navegador'],['contacto-cookies','Contacto y cambios']],
    } },
  ];
}
const { title,description,intro,contents } = Astro.props;
const page = Astro.params.legal;
const Icon = page === 'privacidad' ? ShieldCheck : page === 'cookies' ? Settings2 : FileCheck2;
const policies = [['aviso-legal','Aviso legal'],['privacidad','Privacidad'],['cookies','Cookies']];
---
<Layout title={`${title} · SeviElectro`} description={description}>
  <Header/>
  <main id="contenido" class="legal-page">
    <div class="container">
      <div class="legal-hero">
        <a class="legal-back" href="/"><ArrowLeft size={16}/> Volver a SeviElectro</a>
        <div class="legal-title-row"><div><p class="eyebrow">SEVIELECTRO / TRANSPARENCIA</p><h1>{title}</h1></div><span class="legal-icon" aria-hidden="true"><Icon size={32}/></span></div>
        <p class="legal-intro">{intro}</p>
        <p class="legal-meta"><span>Quito, Ecuador</span><span>Actualización: <time datetime={PRIVACY_VERSION}>{PRIVACY_DATE_LABEL}</time></span></p>
      </div>
      <div class="legal-layout">
        <aside class="legal-sidebar"><nav aria-label="Índice de esta página"><p>En esta página</p><ol>{contents.map(([id,label],index) => <li><a href={`#${id}`}><span aria-hidden="true">{String(index + 1).padStart(2,'0')}</span>{label}</a></li>)}</ol></nav><div class="legal-help"><ShieldCheck size={20} aria-hidden="true"/><p>Tu información,<br/><strong>con claridad.</strong></p><a href="/#contacto">Contacta con nosotros <ArrowUpRight size={15}/></a></div></aside>
        <div class="legal-body">
          {page === 'aviso-legal' && <LegalNotice/>}
          {page === 'privacidad' && <PrivacyPolicy/>}
          {page === 'cookies' && <CookiePolicy/>}
          <nav class="legal-related" aria-label="Documentos legales">{policies.map(([slug,label]) => <a href={`/${slug}/`} aria-current={page === slug ? 'page' : undefined}>{label}<ArrowUpRight size={15}/></a>)}</nav>
        </div>
      </div>
    </div>
  </main>
  <Footer/>
</Layout>
